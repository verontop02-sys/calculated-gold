PORT=8787
# Несколько фронтов: через запятую (прод: https://gold-panel.web.app,https://gold-panel.firebaseapp.com)
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://xxxx.supabase.co

# Только legacy service_role (JWT, строка начинается с eyJ).
# Dashboard → Settings → API Keys → «Legacy anon, service_role» → service_role → Copy.
# Не использовать sb_secret_… — иначе auth.getUser не работает.
SUPABASE_SERVICE_ROLE_KEY=

PRICE_CACHE_TTL_SEC=180

# Источник курса золота: auto | moex | cbr
# auto — Мосбиржа (фьючерс GLDRUBF, руб/г), при сбое официальный курс ЦБ
# moex — только Мосбиржа
# cbr — только ЦБ (как раньше)
PRICE_SOURCE=auto

# Опционально: свой URL ISS (по умолчанию GLDRUBF на FORTS)
# MOEX_GOLD_ISS_URL=https://iss.moex.com/iss/engines/futures/markets/forts/securities/GLDRUBF.json

# Вкладка XAUT USD: цена Tether Gold (CoinGecko) × курс USD ЦБ. При 429 смените URL или добавьте ключ в свой прокси.
# COINGECKO_XAUT_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether-gold&vs_currencies=usd

# ── Полевая сделка (СМС + ссылка /podtverzhdenie/...) ───────────────────────
# Секрет для HMAC кода (в prod задайте свой длинный случайный).
# FIELD_DEAL_CODE_PEPPER=
# TTL кода в секундах (по умолчанию 600).
# FIELD_DEAL_CODE_TTL_SEC=600
# Макс. неверных попыток (по умолчанию 5).
# FIELD_DEAL_MAX_ATTEMPTS=5
# Боевой режим: код НЕ возвращать в API (в prod всегда 0 или переменную не задавать).
# FIELD_DEAL_RETURN_CODE=0
# Для короткой приёмки локально: FIELD_DEAL_RETURN_CODE=1 (покажет код в ответе и в модалке договора).

# ── Fintech-кабинет клиента (Этап 9, инвестиции в золото) ───────────────────
# Комиссия и минимальная покупка настраиваются в app_kv (key: fintech_settings) через код,
# не через .env — правится через будущий UI настроек биржи.
# Для короткой приёмки локально: FINTECH_OTP_RETURN_CODE=1 (покажет OTP-код в ответе, В PROD НЕ ВКЛЮЧАТЬ).
# FINTECH_OTP_RETURN_CODE=0

# ── AI-ассистент Grok (x.ai) в кабинете инвестиций ──────────────────────────
# Без ключа ассистент работает в локальном режиме (детерминированный анализ и прогноз).
# С ключом ответы генерирует Grok: https://console.x.ai → API Keys.
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# ── Чат поддержки: уведомление в Telegram о новых сообщениях клиентов ────────
# 1) Создайте бота у @BotFather → получите токен.
# 2) Добавьте бота в группу поддержки (или напишите ему в личку) и узнайте chat_id
#    (например через @userinfobot или https://api.telegram.org/bot<TOKEN>/getUpdates).
# Без этих переменных чат работает, просто без пушей в Telegram.
# TELEGRAM_BOT_TOKEN=123456789:AAA...
# TELEGRAM_SUPPORT_CHAT_ID=-1001234567890
#
# Если группу сделали супергруппой — старый chat_id перестаёт работать.
# Telegram вернёт migrate_to_chat_id; в коде есть автоповтор, но env лучше обновить.
#
# Заявки с публичного лендинга (форма «Оставить заявку») пушатся в тот же бот.
# По умолчанию — в TELEGRAM_SUPPORT_CHAT_ID; можно указать отдельный чат:
# TELEGRAM_LEADS_CHAT_ID=-1001234567890

# ── ОБЯЗАТЕЛЬНО задать на Render ─────────────────────────────────────────────
# Публичный origin панели — используется в ссылке внутри SMS клиенту.
# Если не задан — ссылка укажет на localhost и не откроется у клиента!
# PUBLIC_APP_ORIGIN=https://reaktivo.pro

# ── SMS.ru (https://sms.ru) ───────────────────────────────────────────────────
# Без SMSRU_API_ID сервер работает в stub-режиме: SMS пишется в лог, клиенту НЕ приходит.
# SMSRU_API_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Буквенный отправитель — задавать ТОЛЬКО после одобрения заявок в кабинете SMS.ru
# (заявки в Билайн / МТС / Мегафон должны быть одобрены, иначе SMS блокируется операторами).
# SMSRU_FROM=REAKTIVO
#
# Дневной лимит SMS.ru: у новых аккаунтов = 10 шт/день.
# Увеличить: кабинет SMS.ru → Настройки → Дневной лимит → подать заявку.

# ── Безопасность панели: доверенные устройства ───────────────────────────────
# Первый вход с нового устройства подтверждается 6-значным кодом на почту
# сотрудника (письма через Resend, см. ниже). Устройство запоминается.
# Аварийное отключение проверки (если что-то пошло не так): DEVICE_TRUST_ENFORCE=0
# DEVICE_TRUST_ENFORCE=1
# Только локальная приёмка: вернуть код в ответе API (в prod НЕ включать!)
# DEVICE_TRUST_RETURN_CODE=0

# ── Email (Resend.com) ────────────────────────────────────────────────────────
# Письма: PDF-квитанция оператору + чек клиенту после подтверждения.
# Шаги: 1) Зарегистрироваться на resend.com  2) Add domain → подтвердить DNS
#       3) Create API Key → скопировать ниже  4) Задать адрес отправителя.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# DEAL_RECEIPT_EMAIL_FROM=REAKTIVO <noreply@mail.reaktivo.pro>

# ── Grok AI (x.ai) — строка AI на дашборде и в аналитике ─────────────────────
# Без ключа эндпоинт /api/ai/ask вернёт 503, виджет покажет «AI не настроен».
# GROK_API_KEY=xai-xxxxxxxxxxxxxxxx
# Модель можно переопределить (по умолчанию grok-3-mini — быстрая и дешёвая):
# GROK_MODEL=grok-3-mini

# ── Индекс золота (карта регионов / конкуренты) — только super_admin в API ───
# Три порога по возрастанию (индекс = рыночная цена / эталон выкупа по пробе)
# GREEN ≤ a, YELLOW ≤ b, ORANGE ≤ c, иначе RED
# GOLD_INDEX_THRESHOLDS=1.03,1.10,1.18
# Геокодер POST /api/gold-index/geocode (OpenStreetMap Nominatim): свой User-Agent по правилам сервиса
# NOMINATIM_USER_AGENT=YourApp/1.0 (contact@example.com)

PORT=8787
# Несколько фронтов: через запятую (прод: https://gold-panel.web.app,https://gold-panel.firebaseapp.com)
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://xxxx.supabase.co

# Только legacy service_role (JWT, строка начинается с eyJ).
# Dashboard → Settings → API Keys → «Legacy anon, service_role» → service_role → Copy.
# Не использовать sb_secret_… — иначе auth.getUser не работает.
SUPABASE_SERVICE_ROLE_KEY=

PRICE_CACHE_TTL_SEC=180

# Источник курса золота: auto | moex | cbr
# auto — Мосбиржа (фьючерс GLDRUBF, руб/г), при сбое официальный курс ЦБ
# moex — только Мосбиржа
# cbr — только ЦБ (как раньше)
PRICE_SOURCE=auto

# Опционально: свой URL ISS (по умолчанию GLDRUBF на FORTS)
# MOEX_GOLD_ISS_URL=https://iss.moex.com/iss/engines/futures/markets/forts/securities/GLDRUBF.json

# Вкладка XAUT USD: цена Tether Gold (CoinGecko) × курс USD ЦБ. При 429 смените URL или добавьте ключ в свой прокси.
# COINGECKO_XAUT_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether-gold&vs_currencies=usd

# ── Полевая сделка (СМС + ссылка /podtverzhdenie/...) ───────────────────────
# Секрет для HMAC кода (в prod задайте свой длинный случайный).
# FIELD_DEAL_CODE_PEPPER=
# TTL кода в секундах (по умолчанию 600).
# FIELD_DEAL_CODE_TTL_SEC=600
# Макс. неверных попыток (по умолчанию 5).
# FIELD_DEAL_MAX_ATTEMPTS=5
# Боевой режим: код НЕ возвращать в API (в prod всегда 0 или переменную не задавать).
# FIELD_DEAL_RETURN_CODE=0
# Для короткой приёмки локально: FIELD_DEAL_RETURN_CODE=1 (покажет код в ответе и в модалке договора).
#
# Публичный origin панели для ссылки подтверждения в ответе POST /field-deal-sessions (иначе берётся первый из CORS_ORIGIN).
# PUBLIC_APP_ORIGIN=https://reaktivo.pro

# SMS.RU: https://sms.ru → api_id
# SMSRU_API_ID=
# После согласования буквенного отправителя в кабинете — то же имя в API (латиница):
# SMSRU_FROM=REAKTIVO

# Письмо с PDF после подтверждения клиентом: https://resend.com
# Домен отправителя должен быть Verified в Resend (пример после DNS: mail.reaktivo.pro).
# RESEND_API_KEY=re_...
# DEAL_RECEIPT_EMAIL_FROM=REAKTIVO <rm@mail.reaktivo.pro>

# ── Индекс золота (карта регионов / конкуренты) — только super_admin в API ───
# Три порога по возрастанию (индекс = рыночная цена / эталон выкупа по пробе)
# GREEN ≤ a, YELLOW ≤ b, ORANGE ≤ c, иначе RED
# GOLD_INDEX_THRESHOLDS=1.03,1.10,1.18
# Геокодер POST /api/gold-index/geocode (OpenStreetMap Nominatim): свой User-Agent по правилам сервиса
# NOMINATIM_USER_AGENT=YourApp/1.0 (contact@example.com)
